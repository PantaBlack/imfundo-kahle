    // Hero Banner — carrusel de slides
    (function() {
      var track = document.getElementById('heroTrack');
      var prevBtn = document.querySelector('.banner-arrow-prev');
      var nextBtn = document.querySelector('.banner-arrow-next');
      if (!track) return;

      var slides = Array.prototype.slice.call(track.querySelectorAll('.hero-slide'));
      if (slides.length < 2) return;

      /* Clones de los extremos para que el ciclo 1 → 2 → 1 sea continuo. */
      var leadingClone = slides[1].cloneNode(true);
      var trailingClone = slides[0].cloneNode(true);
      track.insertBefore(leadingClone, track.firstChild);
      track.appendChild(trailingClone);

      /* Inicia en el carrusel 1. */
      var index = 1;
      var interval;
      var resetIndex = null;

      function update(animated) {
        track.style.transition = animated === false ? 'none' : 'transform 0.5s ease';
        track.style.transform = 'translateX(' + (-(index * 100)) + '%)';
      }

      function next() {
        index += 1;
        update();
        if (index === 3) resetIndex = 1;
      }

      function prev() {
        index -= 1;
        update();
        if (index === 0) resetIndex = 2;
      }

      track.addEventListener('transitionend', function(event) {
        if (event.propertyName !== 'transform' || resetIndex === null) return;
        index = resetIndex;
        resetIndex = null;
        update(false);
      });

      window.addEventListener('resize', function() { update(false); });

      function stopAuto() { clearInterval(interval); interval = null; }
      function startAuto() { stopAuto(); interval = setInterval(next, 4000); }

      if (prevBtn) prevBtn.addEventListener('click', function() { stopAuto(); prev(); startAuto(); });
      if (nextBtn) nextBtn.addEventListener('click', function() { stopAuto(); next(); startAuto(); });

      var banner = document.querySelector('.hero-banner');
      if (banner) {
        banner.addEventListener('mouseenter', stopAuto);
        banner.addEventListener('mouseleave', startAuto);
      }

      update(false);
      startAuto();
    })();

