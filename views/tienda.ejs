    <main class="tienda-page">
  <!-- Banner Metro -->
  <section>
    <div class="hero-banner">

      <!-- Track de slides -->
      <div class="hero-track" id="heroTrack">

        <!-- Slide 1: Categorías -->
        <div class="hero-slide">
          <div class="hero-panel">
            <img class="hero-panel-img hero-panel-img--cover" src="/img/tienda/IzquierdaYDerecha/productos/Cristal.png" alt="Cristalería">
            <div class="hero-panel-overlay"></div>
            <div class="hero-panel-content">
              <span class="hero-panel-label">Cristalería</span>
              <button class="btn-ver-mas">Ver más</button>
            </div>
          </div>
          <div class="hero-panel">
            <img class="hero-panel-img hero-panel-img--cover" src="/img/tienda/IzquierdaYDerecha/productos/Ceramica.png" alt="Cerámica">
            <div class="hero-panel-overlay"></div>
            <div class="hero-panel-content">
              <span class="hero-panel-label">Cerámica</span>
              <button class="btn-ver-mas">Ver más</button>
            </div>
          </div>
          <div class="hero-panel">
            <img class="hero-panel-img hero-panel-img--cover" src="/img/tienda/IzquierdaYDerecha/productos/Textil.png" alt="Textil">
            <div class="hero-panel-overlay"></div>
            <div class="hero-panel-content">
              <span class="hero-panel-label">Textil</span>
              <button class="btn-ver-mas">Ver más</button>
            </div>
          </div>
        </div>

        <!-- Slide 2: Accesorios -->
        <div class="hero-slide">
          <div class="hero-panel">
            <img class="hero-panel-img" src="/img/tienda/IzquierdaYDerecha/productos/CAP1.png" alt="CAP">
            <div class="hero-panel-overlay"></div>
            <div class="hero-panel-content">
              <span class="hero-panel-label">CAP</span>
              <button class="btn-ver-mas" data-detail-product="CAP">Ver más</button>
            </div>
          </div>
          <div class="hero-panel">
            <img class="hero-panel-img" src="/img/tienda/IzquierdaYDerecha/productos/CON1.png" alt="CON">
            <div class="hero-panel-overlay"></div>
            <div class="hero-panel-content">
              <span class="hero-panel-label">CON</span>
              <button class="btn-ver-mas" data-detail-product="CON">Ver más</button>
            </div>
          </div>
          <div class="hero-panel">
            <img class="hero-panel-img" src="/img/tienda/IzquierdaYDerecha/productos/S1.png" alt="S">
            <div class="hero-panel-overlay"></div>
            <div class="hero-panel-content">
              <span class="hero-panel-label">Accesorios</span>
              <button class="btn-ver-mas" data-detail-product="S">Ver más</button>
            </div>
          </div>
        </div>

      </div><!-- /hero-track -->

      <!-- Arrows -->
      <button class="banner-arrow banner-arrow-prev" aria-label="Anterior">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="banner-arrow banner-arrow-next" aria-label="Siguiente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>

    </div>
  </section>

  <!-- Shop Layout: Sidebar izquierda + Main derecha -->
    <div class="shop-layout">

      <!-- Sidebar filtros SIEMPRE visible -->
      <aside class="filter-sidebar" id="filterSidebar">
        <div class="filter-accordion">
          <details class="filter-group">
            <summary>Departamento <svg class="chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
            <div class="filter-options">
              <label><input type="checkbox"> Cusco</label>
              <label><input type="checkbox"> Arequipa</label>
              <label><input type="checkbox"> Lima</label>
            </div>
          </details>

          <details class="filter-group">
            <summary>Categoría <svg class="chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
            <div class="filter-options">
              <label><input type="checkbox"> Cristalería</label>
              <label><input type="checkbox"> Cerámica</label>
              <label><input type="checkbox"> Textil</label>
              <label><input type="checkbox"> Joyería</label>
              <label><input type="checkbox"> Accesorios</label>
            </div>
          </details>

          <details class="filter-group">
            <summary>Sub-Categoría <svg class="chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
            <div class="filter-options">
              <label><input type="checkbox"> Opción A</label>
              <label><input type="checkbox"> Opción B</label>
            </div>
          </details>

          <details class="filter-group">
            <summary>Marca <svg class="chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
            <div class="filter-options">
              <label><input type="checkbox"> Marca 1</label>
              <label><input type="checkbox"> Marca 2</label>
            </div>
          </details>

          <details class="filter-group">
            <summary>Tipo de Producto <svg class="chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
            <div class="filter-options">
              <label><input type="checkbox"> Tipo 1</label>
              <label><input type="checkbox"> Tipo 2</label>
            </div>
          </details>

          <details class="filter-group">
            <summary>Rango de precio <svg class="chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary>
            <div class="filter-options">
              <div class="price-slider-visual">
                <div class="price-track">
                  <div class="price-fill"></div>
                  <div class="price-thumb price-thumb-min"></div>
                  <div class="price-thumb price-thumb-max"></div>
                </div>
                <span class="price-range-label">S/ 1.00 – S/ 54.00</span>
              </div>
            </div>
          </details>
        </div>
      </aside>

      <!-- Main: Buscador + Grid -->
      <div class="shop-main">

        <!-- Botón filtros (solo móvil) -->
        <button class="mobile-filter-btn" id="mobileFilterBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
          Filtros
        </button>

        <!-- Breadcrumb -->
        <nav class="breadcrumb">
          <a href="/">Inicio</a>
          <span class="breadcrumb-separator">/</span>
          <a href="/tienda">Tienda</a>
          <span class="breadcrumb-separator">/</span>
          <span class="breadcrumb-current" id="breadcrumbCurrent"></span>
        </nav>

        <!-- Buscador de productos -->
        <div class="product-search-wrap">
          <div class="product-search-box">
            <svg class="product-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" id="productSearch" placeholder="Buscar productos..." autocomplete="off">
            <button class="product-search-clear" id="searchClear" aria-label="Limpiar búsqueda" style="display:none;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        </div>

        <!-- Grid de productos -->
        <div class="product-grid" id="productGrid">
      <!-- Tarjeta 1: Vaso -->
