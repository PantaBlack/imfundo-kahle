    // Product Search
    (function() {
      var searchInput = document.getElementById('productSearch');
      var searchClear = document.getElementById('searchClear');
      var grid = document.getElementById('productGrid');
      var breadcrumbCurrent = document.getElementById('breadcrumbCurrent');
      let noResultsMsg = null;

      function getCards() { 
        return document.querySelectorAll('#productGrid .product-card, #featuredGrid .product-card'); 
      }

      function getCardText(card) {
        var name = card.querySelector('.product-name');
        var category = card.querySelector('.product-category');
        var origin = card.querySelector('.product-origin');
        return (name ? name.textContent : '') + ' ' +
               (category ? category.textContent : '') + ' ' +
               (origin ? origin.textContent : '');
      }

      function updateSearchState(query) {
        searchClear.style.display = query.length > 0 ? 'flex' : 'none';
        if (breadcrumbCurrent) breadcrumbCurrent.textContent = query || '';
      }

      function getCheckedFilters() {
        var activeDepartamentos = [];
        var activeCategorias = [];

        document.querySelectorAll('.filter-group').forEach(function(group) {
          var summary = group.querySelector('summary');
          if (!summary) return;
          var label = summary.childNodes[0].textContent.trim().toLowerCase();
          group.querySelectorAll('input[type="checkbox"]:checked').forEach(function(cb) {
            var val = cb.parentElement.textContent.trim();
            if (label.indexOf('departamento') !== -1) {
              activeDepartamentos.push(val.toUpperCase());
            } else if (label.indexOf('categor') !== -1) {
              activeCategorias.push(val);
            }
          });
        });

        return { departamentos: activeDepartamentos, categorias: activeCategorias };
      }

      function filterProducts() {
        var query = searchInput.value.trim().toLowerCase();
        var visibleCount = 0;
        var accesoriosSection = document.getElementById('accesoriosSection');
        var checked = getCheckedFilters();
        var priceFilter = window.productPriceFilter || null;
        updateSearchState(query);

        getCards().forEach(function(card) {
          var text = getCardText(card).toLowerCase();
          var origin = (card.querySelector('.product-origin') || {}).textContent || '';
          var category = (card.querySelector('.product-category') || {}).textContent || '';
          var priceEl = card.querySelector('.product-price strong');
          var price = priceEl ? parseFloat(priceEl.textContent) : NaN;
          var matches = true;

          if (query && text.indexOf(query) === -1) matches = false;
          if (checked.departamentos.length && checked.departamentos.indexOf(origin) === -1) matches = false;
          if (checked.categorias.length && checked.categorias.indexOf(category) === -1) matches = false;
          if (priceFilter && !isNaN(price) && (price < priceFilter.min || price > priceFilter.max)) matches = false;

          if (matches) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (query.length > 0) {
          if (accesoriosSection) accesoriosSection.style.display = 'none';
        } else {
          if (accesoriosSection) accesoriosSection.style.display = '';
        }

        if (visibleCount === 0 && query.length > 0) {
          if (!noResultsMsg) {
            noResultsMsg = document.createElement('div');
            noResultsMsg.className = 'search-no-results';
            noResultsMsg.innerHTML = '<strong>No se encontraron productos</strong>Intenta con otra palabra o categoría';
            grid.appendChild(noResultsMsg);
          }
          noResultsMsg.style.display = '';
        } else if (noResultsMsg) {
          noResultsMsg.style.display = 'none';
        }
      }

      window.applyProductFilters = filterProducts;
      searchInput.addEventListener('input', filterProducts);
      searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          filterProducts();
          grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
      searchClear.addEventListener('click', function() {
        searchInput.value = '';
        searchClear.style.display = 'none';
        if (breadcrumbCurrent) breadcrumbCurrent.textContent = '';
        if (noResultsMsg) noResultsMsg.style.display = 'none';
        searchInput.focus();
        var sec = document.getElementById('accesoriosSection'); if (sec) sec.style.display = '';
        filterProducts();
      });

      window.applyProductFilters = filterProducts;
    })();

    // Product carousels
    function initCarousels() {
      document.querySelectorAll('.product-carousel').forEach(function(carousel, idx) {
        if (carousel._init) return;
        carousel._init = true;
        var track = carousel.querySelector('.carousel-track');
        var slides = carousel.querySelectorAll('.carousel-slide');
        var prevBtn = carousel.querySelector('.carousel-arrow-prev');
        var nextBtn = carousel.querySelector('.carousel-arrow-next');
        var dots = carousel.querySelectorAll('.carousel-dots .dot');
        var index = 0;
        var total = slides.length;
        var autoInterval;
        if (!track || total === 0) return;

        function update() {
          track.style.transform = 'translateX(' + (-index * 100) + '%)';
          dots.forEach(function(d, i) { d.classList.toggle('active', i === index); });
          slides.forEach(function(s, i) { s.classList.toggle('active', i === index); });
        }

        function nextSlide() {
          index = (index + 1) % total;
          update();
        }

        function startAuto() {
          autoInterval = setInterval(nextSlide, 3000);
        }

        function stopAuto() {
          clearInterval(autoInterval);
        }

        if (prevBtn) prevBtn.addEventListener('click', function() { stopAuto(); index = (index - 1 + total) % total; update(); startAuto(); });
        if (nextBtn) nextBtn.addEventListener('click', function() { stopAuto(); index = (index + 1) % total; update(); startAuto(); });
        dots.forEach(function(d, i) { d.addEventListener('click', function() { stopAuto(); index = i; update(); startAuto(); }); });

        // Auto-scroll con delay escalonado
        setTimeout(function() {
          startAuto();
          carousel.addEventListener('mouseenter', stopAuto);
          carousel.addEventListener('mouseleave', startAuto);
        }, idx * 500);
      });
    }

    // Scroll Observer - Animaciones al hacer scroll
    function initScrollObserver() {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry, index) {
          if (entry.isIntersecting) {
            setTimeout(function() {
              entry.target.classList.add('visible');
            }, index * 100);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      document.querySelectorAll('.product-card').forEach(function(card) {
        observer.observe(card);
      });
    }

    // Efecto de Confeti al agregar al carrito
    function createConfetti(button) {
      var colors = ['#E84A3C', '#FFD700', '#4CAF50', '#2196F3', '#FF6B5B'];
      var rect = button.getBoundingClientRect();
      
      for (var i = 0; i < 8; i++) {
        var confetti = document.createElement('div');
        confetti.className = 'confetti-piece';
        confetti.style.cssText = 
          'position:fixed;' +
          'left:' + (rect.left + rect.width / 2) + 'px;' +
          'top:' + (rect.top + rect.height / 2) + 'px;' +
          'width:' + (6 + Math.random() * 6) + 'px;' +
          'height:' + (6 + Math.random() * 6) + 'px;' +
          'background:' + colors[Math.floor(Math.random() * colors.length)] + ';' +
          'border-radius:' + (Math.random() > 0.5 ? '50%' : '2px') + ';' +
          'pointer-events:none;' +
          'z-index:9999;' +
          'animation:confetti ' + (0.6 + Math.random() * 0.4) + 's ease-out forwards;' +
          'transform:translate(' + (Math.random() * 60 - 30) + 'px,' + (Math.random() * 60 - 30) + 'px)';
        document.body.appendChild(confetti);
        setTimeout(function(el) { return function() { el.remove(); }; }(confetti), 1000);
      }
    }

    // Animación al agregar al carrito
    function initAddToCart() {
      document.querySelectorAll('.btn-add-cart').forEach(function(btn) {
        if (btn._cartInit) return;
        btn._cartInit = true;
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          if (btn.classList.contains('added')) return;

          createConfetti(btn);
          btn.classList.add('added');

          if (typeof window.addToFloatingCart === 'function') {
            window.addToFloatingCart(btn);
          }

          setTimeout(function() { btn.classList.remove('added'); }, 2000);
        });
      });
    }
    function initProductDetailLinks() {
      document.querySelectorAll('.product-card').forEach(function(card) {
        if (card._detailInit) return;
        card._detailInit = true;
        card.tabIndex = 0;
        card.setAttribute('role', 'link');
        card.setAttribute('aria-label', 'Ver detalle del producto');

        function openDetail() {
          var name = card.querySelector('.product-name');
          if (!name) return;
          var price = card.querySelector('.product-price strong');
          var category = card.querySelector('.product-category');
          var origin = card.querySelector('.product-origin');
          var designImage = card.querySelector('.front-design-overlay');
          var images = Array.prototype.slice.call(card.querySelectorAll('.product-image-wrap img, .product-carousel img'))
            .filter(function(img) { return !img.classList.contains('front-design-overlay'); })
            .map(function(img) { return img.src; })
            .filter(function(src, index, list) { return src && list.indexOf(src) === index; });
          var stockBadge = card.querySelector('.stock-badge');
          var cardStockAttr = card.getAttribute('data-stock');
          var cardStock = cardStockAttr !== null ? parseInt(cardStockAttr) : NaN;
          var sinStock = !isNaN(cardStock) ? cardStock === 0 : (stockBadge && stockBadge.textContent.trim().toLowerCase().includes('sin stock'));
          var oldPriceEl = card.querySelector('.old-price');
          var product = {
            name: name.textContent.trim(),
            price: price ? price.textContent.trim() : '0',
            oldPrice: oldPriceEl ? oldPriceEl.textContent.trim() : null,
