  }
  function unlockScroll() {
    var anyOpen = document.querySelector('.product-modal.open, .cart-overlay.open, .yape-overlay.open, .settings-overlay.open, .checkout-flow-overlay.open');
    if (!anyOpen) {
      document.body.classList.remove('scroll-locked');
      document.documentElement.classList.remove('scroll-locked');
    }
  }

  // ── Focus trap para modales ────────────────────────────────────
  var focusableSelector = 'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])';

  function trapFocus(container) {
    var focusable = container.querySelectorAll(focusableSelector);
    if (!focusable.length) return;
    var firstFocusable = focusable[0];
    var lastFocusable = focusable[focusable.length - 1];
    firstFocusable && firstFocusable.focus();

    container.addEventListener('keydown', function handler(e) {
      if (e.key !== 'Tab') return;
      if (e.shiftKey) {
        if (document.activeElement === firstFocusable) {
          e.preventDefault();
          lastFocusable && lastFocusable.focus();
        }
      } else {
        if (document.activeElement === lastFocusable) {
          e.preventDefault();
          firstFocusable && firstFocusable.focus();
        }
      }
    });
  }

  // ── Carrito flotante ──────────────────────────────────────────
  (function() {
    var floatingCart  = document.getElementById('floatingCart');
    var countEl       = document.getElementById('floatingCartCount');
    var cartOverlay   = document.getElementById('cartOverlay');
    var cartItemsList = document.getElementById('cartItemsList');
    var closeBtn      = document.getElementById('cartBoxClose');

    var STORAGE_SAVED = 'imfundo_saved';
    var STORAGE_CART  = 'imfundo_cart';
    var cartItems = [];
    var savedProducts = [];

    function saveCart() {
      try { localStorage.setItem(STORAGE_CART, JSON.stringify(cartItems)); } catch(e) {}
    }

    function loadCart() {
      try {
        var data = localStorage.getItem(STORAGE_CART);
        if (data) { cartItems = JSON.parse(data); }
      } catch(e) {}
    }

    function saveSaved() {
      try { localStorage.setItem(STORAGE_SAVED, JSON.stringify(savedProducts)); } catch(e) {}
    }

    function loadSaved() {
      try {
        var data = localStorage.getItem(STORAGE_SAVED);
        if (data) { savedProducts = JSON.parse(data); }
      } catch(e) {}
    }

    function isSaved(name) {
      return savedProducts.some(function(s) { return s.name === name; });
    }

    function toggleSaved(itemData) {
      var idx = savedProducts.findIndex(function(s) { return s.name === itemData.name; });
      if (idx !== -1) { savedProducts.splice(idx, 1); }
      else { savedProducts.push({ name: itemData.name, category: itemData.category, origin: itemData.origin, price: itemData.price, img: itemData.img, images: itemData.images, designOverlay: itemData.designOverlay || '' }); }
      saveSaved();
    }

    function renderSavedIndicators() {
      document.querySelectorAll('.product-card').forEach(function(card) {
        var name = (card.querySelector('.product-name') || {}).textContent || '';
        var existing = card.querySelector('.saved-badge');
        if (isSaved(name)) {
          if (!existing) {
            var badge = document.createElement('span');
            badge.className = 'saved-badge';
            card.querySelector('.product-image-wrap').appendChild(badge);
          }
        } else {
          if (existing) existing.remove();
        }
      });
    }

    loadCart();
    loadSaved();
    renderSavedIndicators();
    if (cartItems.length > 0) { floatingCart.classList.add('visible'); updateCount(); }

    // Ribbon diagonal para productos sin stock
    document.querySelectorAll('.product-card').forEach(function(card) {
      var dataStock = card.getAttribute('data-stock');
      var stockBadge = card.querySelector('.stock-badge');
      var sinStock = dataStock !== null
        ? parseInt(dataStock) === 0
        : (stockBadge && stockBadge.textContent.trim().toLowerCase().includes('sin stock'));
      if (sinStock) {
        var wrap = card.querySelector('.product-image-wrap');
        if (wrap && !wrap.querySelector('.sin-stock-ribbon')) {
          var ribbon = document.createElement('div');
          ribbon.className = 'sin-stock-ribbon';
          ribbon.textContent = 'Sin stock';
          wrap.appendChild(ribbon);
        }
      }
    });

    // ── Helpers ──────────────────────────────────────────────────
    function getPrice(card) {
      var strong = card.querySelector('.product-price strong');
      if (!strong) return null;
      var v = parseFloat(strong.textContent);
      return isNaN(v) ? null : v;
    }

    function getImg(card) {
      var img = card.querySelector('.product-image-wrap img, .carousel-slide img');
      return img ? img.src : '';
    }

    function totalQty() { return cartItems.reduce(function(s,i){return s+i.qty;},0); }

    function calcSubtotal() {
      return cartItems.reduce(function(s,i){return s+(i.price!==null?i.price*i.qty:0);},0);
    }

    function updateCount() {
      var qty = totalQty();
      countEl.textContent = qty;
      countEl.style.animation = 'none';
      void countEl.offsetWidth;
      countEl.style.animation = '';
    }

    function updateSummary() {
      var sub  = calcSubtotal();
      var ship = sub > 0 ? 9.90 : 0;
      var tax  = sub * 0.10;
      var tot  = sub + ship + tax;
      var n    = totalQty();
      var subEl   = document.getElementById('cartSubtotal');
      var taxEl   = document.getElementById('cartTax');
      var totEl   = document.getElementById('cartTotalAmount');
      var lblEl   = document.getElementById('cartSubtotalLabel');
      var titEl   = document.getElementById('cartBoxTitle');
      if (subEl)  subEl.textContent  = sub.toFixed(2);
      if (taxEl)  taxEl.textContent  = tax.toFixed(2);
      if (totEl)  totEl.textContent  = tot.toFixed(2);
      if (lblEl)  lblEl.textContent  = 'Subtotal (' + n + ' ' + (n===1?'artículo':'artículos') + ')';
      if (titEl)  titEl.textContent  = 'Tu Carrito (' + totalQty() + ')';
    }

    function summaryRowsHtml(totals) {
      return '' +
        '<div class="cart-summary-row"><span>Subtotal</span><span>S/ ' + totals.subtotal.toFixed(2) + '</span></div>' +
        '<div class="cart-summary-row"><span>Envio</span><span>S/ ' + totals.shipping.toFixed(2) + '</span></div>' +
        '<div class="cart-summary-row"><span>IGV (10%)</span><span>S/ ' + totals.tax.toFixed(2) + '</span></div>' +
        '<hr class="cart-summary-divider">' +
        '<div class="cart-summary-total"><span>Total</span><span>S/ ' + totals.total.toFixed(2) + '</span></div>';
    }

    function setCheckoutPayment(method) {
      activeCheckoutPayment = method || 'yape';
      paymentTabs.forEach(function(tab) {
        tab.classList.toggle('active', tab.getAttribute('data-payment') === activeCheckoutPayment);
      });
      paymentPanels.forEach(function(panel) {
        panel.classList.toggle('active', panel.getAttribute('data-payment-panel') === activeCheckoutPayment);
      });

      var notes = {
        yape: 'Escanea el QR de Yape para completar el pago.',
        transfer: 'Se generara una orden pendiente para confirmar la transferencia.',
        card: 'Se generara una orden lista para conectar con la pasarela de tarjeta.'
      };
      if (checkoutPaymentInfo) checkoutPaymentInfo.textContent = notes[activeCheckoutPayment] || notes.yape;
    }

    function itemPrice(item) {
      return item.price !== null ? 'S/ ' + (item.price * item.qty).toFixed(2) : 'S/ —';
    }

    function openCartImagePreview(src, alt, designOverlay) {
      if (!src) return;
      var preview = document.getElementById('cartImagePreview');
      if (!preview) {
        preview = document.createElement('div');
        preview.id = 'cartImagePreview';
        preview.className = 'cart-image-preview';
        preview.innerHTML = '<button class="cart-image-preview-close" type="button" aria-label="Cerrar">×</button><div class="cart-image-preview-stage"><img alt="Vista ampliada"><img class="cart-image-preview-design" alt=""></div>';
        (document.querySelector('.tienda-page') || document.body).appendChild(preview);
        preview.querySelector('.cart-image-preview-close').addEventListener('click', function() { preview.classList.remove('open'); });
        preview.addEventListener('click', function(event) { if (event.target === preview) preview.classList.remove('open'); });
      }
      var image = preview.querySelector('.cart-image-preview-stage > img:first-child');
      var design = preview.querySelector('.cart-image-preview-design');
      image.src = src;
      image.alt = alt || 'Vista ampliada del producto';
      design.src = designOverlay || '';
      design.style.display = designOverlay ? 'block' : 'none';
      preview.classList.add('open');
    }

    function renderCart() {
      updateSummary();
      if (cartItems.length === 0) {
        floatingCart.classList.remove('visible');
        cartItemsList.innerHTML = '<div class="cart-empty">Tu carrito está vacío</div>';
        return;
      }
      cartItemsList.innerHTML = '';
      cartItems.forEach(function(item, idx) {
        var div = document.createElement('div');
        div.className = 'cart-item';
        var outOfStock = item.stock === 0;

        var imgHtml;
        if (item.designOverlay) {
          imgHtml = '<div class="cart-item-carousel" style="position:relative;overflow:hidden">' +
            '<img src="' + item.images[0] + '" alt="' + item.name + '" style="width:100%;height:100%;object-fit:contain;display:block">' +
            '<img class="cart-design-overlay" src="' + item.designOverlay + '" style="position:absolute;top:-10%;left:50%;transform:translateX(-50%);width:35%;pointer-events:none">' +
            '</div>';
        } else if (item.images && item.images.length > 0) {
          imgHtml = '<img class="cart-item-img" src="' + item.images[0] + '" alt="' + item.name + '">';
        } else {
          imgHtml = item.img ? '<img class="cart-item-img" src="' + item.img + '" alt="' + item.name + '">' : '';
        }

        div.innerHTML =
          imgHtml +
          '<div class="cart-item-body">' +
            '<div class="cart-item-name">' + item.name + '</div>' +
            '<div class="cart-item-meta">' + item.category + ' · ' + item.origin + '</div>' +
            '<div class="cart-item-stock">En stock</div>' +
            '<div class="cart-item-actions">' +
              '<div class="cart-item-qty">' +
                '<button class="cart-qty-btn" data-action="dec" data-idx="' + idx + '"' + (outOfStock ? ' disabled style="opacity:0.35"' : '') + '>−</button>' +
                '<span class="cart-qty-num">' + item.qty + '</span>' +
                '<button class="cart-qty-btn" data-action="inc" data-idx="' + idx + '"' + (outOfStock || (item.stock != null && item.stock > 0 && item.qty >= item.stock) ? ' disabled style="opacity:0.35"' : '') + '>+</button>' +
              '</div>' +
              '<button class="cart-item-action-btn cart-item-remove" data-idx="' + idx + '">' +
                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>' +
                'Eliminar' +
              '</button>' +
            '</div>' +
          '</div>' +
          '<div class="cart-item-right">' +
            (item.oldPrice ? '<div class="cart-item-old-price">S/ ' + (item.oldPrice * item.qty).toFixed(2) + '</div>' : '') +
            '<div class="cart-item-price">' + itemPrice(item) + '</div>' +
          '</div>';
        cartItemsList.appendChild(div);
      });

      cartItemsList.querySelectorAll('.cart-qty-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var i = parseInt(btn.getAttribute('data-idx'));
          if (btn.getAttribute('data-action') === 'inc') {
            var s = cartItems[i].stock;
            if (s == null || s <= 0 || cartItems[i].qty < s) cartItems[i].qty++;
          } else { cartItems[i].qty--; if (cartItems[i].qty <= 0) cartItems.splice(i,1); }
          saveCart(); updateCount(); renderCart();
          if (cartItems.length === 0) { cartOverlay.classList.remove('open'); unlockScroll(); }
        });
      });

      cartItemsList.querySelectorAll('.cart-item-remove').forEach(function(btn) {
        btn.addEventListener('click', function() {
          cartItems.splice(parseInt(btn.getAttribute('data-idx')), 1);
          saveCart(); updateCount(); renderCart();
          if (cartItems.length === 0) { cartOverlay.classList.remove('open'); unlockScroll(); }
        });
      });

      cartItemsList.querySelectorAll('.cart-item-carousel').forEach(function(el) {
        el.addEventListener('click', function() {
          var ci   = parseInt(el.getAttribute('data-cart-idx'));
          var cur  = parseInt(el.getAttribute('data-img-cur'));
          var imgs = cartItems[ci] ? cartItems[ci].images : [];
          if (!imgs.length) return;
          cur = (cur + 1) % imgs.length;
          el.setAttribute('data-img-cur', cur);
          el.querySelector('img').src = imgs[cur];
          var overlay = el.querySelector('.cart-design-overlay');
          if (overlay) overlay.style.display = cur === 0 ? '' : 'none';
          el.querySelectorAll('.cart-carousel-dot').forEach(function(dot, i) {
            dot.classList.toggle('active', i === cur);
          });
        });
      });

      cartItemsList.querySelectorAll('.cart-item-img, .cart-item-carousel img').forEach(function(image) {
        image.addEventListener('click', function(event) {
          event.stopPropagation();
          var carousel = image.closest('.cart-item-carousel');
          var overlay = carousel && carousel.querySelector('.cart-design-overlay');
          openCartImagePreview(image.src, image.alt, overlay ? overlay.src : '');
        });
      });

      cartItemsList.querySelectorAll('.cart-item-save').forEach(function(btn) {
        var i = parseInt(btn.getAttribute('data-idx'));
        var item = cartItems[i];
        if (isSaved(item.name)) {
          btn.innerHTML = btn.innerHTML.replace('Guardar', 'Guardado');
          btn.querySelector('svg').setAttribute('fill', '#E84A3C');
          btn.style.color = '#E84A3C';
        }
        btn.addEventListener('click', function() {
          var idx = parseInt(btn.getAttribute('data-idx'));
          var it = cartItems[idx];
          if (it) {
            toggleSaved({ name: it.name, category: it.category, origin: it.origin, price: it.price, img: it.img, images: it.images, designOverlay: it.designOverlay || '' });
            renderSavedIndicators();
            renderCart();
          }
        });
      });
    }

    // ── Agregar al carrito (hook global) ─────────────────────────
    window.addToFloatingCart = function(btn) {
      var card      = btn.closest('.product-card');
      var modalInfo = btn.closest('.modal-info');

      var name, category, origin, price, oldPrice = null, stock = null, img, images, designOverlay = '';

      if (card) {
        name     = (card.querySelector('.product-name')      || {}).textContent || '';
        category = (card.querySelector('.product-category')  || {}).textContent || '—';
        origin   = (card.querySelector('.product-origin')    || {}).textContent || '—';
        price    = getPrice(card);
        var oldPriceEl = card.querySelector('.old-price');
        if (oldPriceEl) { var op = parseFloat(oldPriceEl.textContent.replace('S/', '').trim()); if (!isNaN(op)) oldPrice = op; }
        var sa = card.getAttribute('data-stock'); if (sa !== null) stock = parseInt(sa);
        images   = [];
        designOverlay = '';
        card.querySelectorAll('.carousel-slide img').forEach(function(im) {
          if (im.classList.contains('front-design-overlay')) {
            if (!designOverlay) designOverlay = im.src;
          } else {
            images.push(im.src);
          }
        });
        if (images.length === 0) {
          img = getImg(card);
          images = img ? [img] : [];
        } else {
          img = images[0];
        }
      } else if (modalInfo) {
        var modalBox = modalInfo.closest('.modal-box');
        name     = (modalInfo.querySelector('.modal-name')       || {}).textContent || '';
        category = (modalInfo.querySelector('.product-category') || {}).textContent || '—';
        origin   = (modalInfo.querySelector('.product-origin')   || {}).textContent || '—';
        var priceEl = modalInfo.querySelector('.product-price strong');
        price = priceEl ? parseFloat(priceEl.textContent) : null;
        if (isNaN(price)) price = null;
        images = [];
        if (modalBox) {
          modalBox.querySelectorAll('.modal-thumb').forEach(function(th) { images.push(th.src); });
        }
        img = images[0] || '';
      } else {
        name = btn.getAttribute('data-product') || 'Producto';
        category = '—'; origin = '—'; price = null; img = ''; images = [];
      }

      name = (name || btn.getAttribute('data-product') || 'Producto').trim();

      var existing = cartItems.find(function(i) { return i.name === name; });
      if (existing) {
        var es = existing.stock;
        if (es == null || (es > 0 && existing.qty < es)) existing.qty++;
      } else if (stock !== 0) { cartItems.push({ name: name, category: category, origin: origin, price: price, oldPrice: oldPrice, stock: stock, qty: 1, img: img, images: images, designOverlay: designOverlay }); }

      saveCart();
      if (!floatingCart.classList.contains('visible')) floatingCart.classList.add('visible');
      updateCount();
    };

    // ── Draggable ─────────────────────────────────────────────────
    var dragging = false, startX, startY, origLeft, origTop, moved, touchStartTime = 0, lastTouchTime = 0;

    floatingCart.addEventListener('mousedown', function(e) {
      if (e.button !== 0) return;
      if (Date.now() - lastTouchTime < 700) return;
      dragging = true; moved = false;
      var rect = floatingCart.getBoundingClientRect();
      origLeft = rect.left; origTop = rect.top;
      startX = e.clientX; startY = e.clientY;
      floatingCart.style.right  = 'auto';
      floatingCart.style.bottom = 'auto';
      floatingCart.style.left   = origLeft + 'px';
      floatingCart.style.top    = origTop  + 'px';
      floatingCart.style.transition = 'none';
      e.preventDefault();
    });

    document.addEventListener('mousemove', function(e) {
      if (!dragging) return;
      var dx = e.clientX - startX, dy = e.clientY - startY;
      if (Math.abs(dx) > 4 || Math.abs(dy) > 4) moved = true;
      floatingCart.style.left = (origLeft + dx) + 'px';
      floatingCart.style.top  = (origTop  + dy) + 'px';
    });

    document.addEventListener('mouseup', function() {
      if (!dragging) return;
      dragging = false;
      floatingCart.style.transition = '';
      var size = 64;
      var maxL = window.innerWidth  - size;
      var maxT = window.innerHeight - size;
      floatingCart.style.left = Math.min(Math.max(0, parseFloat(floatingCart.style.left) || 0), maxL) + 'px';
      floatingCart.style.top  = Math.min(Math.max(0, parseFloat(floatingCart.style.top)  || 0), maxT) + 'px';
      if (!moved) openCart();
    });

    // Touch
    floatingCart.addEventListener('touchstart', function(e) {
      var t = e.touches[0];
      var rect = floatingCart.getBoundingClientRect();
      dragging = true; moved = false;
      touchStartTime = Date.now();
      lastTouchTime = touchStartTime;
      origLeft = rect.left; origTop = rect.top;
      startX = t.clientX; startY = t.clientY;
      floatingCart.style.right  = 'auto';
      floatingCart.style.bottom = 'auto';
      floatingCart.style.left   = origLeft + 'px';
      floatingCart.style.top    = origTop  + 'px';
      floatingCart.style.transition = 'none';
    }, { passive: true });

    document.addEventListener('touchmove', function(e) {
      if (!dragging) return;
      var t = e.touches[0];
      var dx = t.clientX - startX, dy = t.clientY - startY;
      if (Math.abs(dx) > 4 || Math.abs(dy) > 4) moved = true;
      floatingCart.style.left = (origLeft + dx) + 'px';
      floatingCart.style.top  = (origTop  + dy) + 'px';
    }, { passive: true });

    document.addEventListener('touchend', function() {
      if (!dragging) return;
      var elapsed = Date.now() - touchStartTime;
      lastTouchTime = Date.now();
      dragging = false;
      floatingCart.style.transition = '';
      var size = 64;
      var maxL = window.innerWidth  - size;
      var maxT = window.innerHeight - size;
      floatingCart.style.left = Math.min(Math.max(0, parseFloat(floatingCart.style.left) || 0), maxL) + 'px';
      floatingCart.style.top  = Math.min(Math.max(0, parseFloat(floatingCart.style.top)  || 0), maxT) + 'px';
      if (!moved && elapsed < 350) openCart();
    });

    // ── Abrir / cerrar modal carrito ──────────────────────────────
    function openCart() {
      cartOverlay.classList.remove('cart-main');
      document.body.classList.remove('cart-main-open');
      document.documentElement.classList.remove('cart-main-open');
      renderCart();
      cartOverlay.classList.add('open');
      lockScroll();
      trapFocus(cartOverlay);
    }

    function openMainCart() {
      renderCart();
      cartOverlay.classList.add('open', 'cart-main');
      document.body.classList.add('cart-main-open');
      document.documentElement.classList.add('cart-main-open');
    }

    function closeCart() {
      cartOverlay.classList.remove('open', 'cart-main');
      cartOverlay.style.display = '';
      document.body.classList.remove('cart-main-open');
      document.documentElement.classList.remove('cart-main-open');
      unlockScroll();
    }

    window.openFloatingCart = openCart;

    var headerCartBtn = document.getElementById('headerCartBtn');
    if (headerCartBtn) headerCartBtn.addEventListener('click', openCart);

    var cartMiniContinue = document.getElementById('cartMiniContinue');
    if (cartMiniContinue) cartMiniContinue.addEventListener('click', openMainCart);
    document.addEventListener('click', function(event) {
      var button = event.target.closest('.cart-rec-arrow');
      if (!button) return;
      var track = button.closest('.cart-recommendations').querySelector('.cart-recommendation-grid');
      var amount = track.clientWidth;
      track.scrollBy({ left: button.dataset.recDirection === 'next' ? amount : -amount, behavior: 'smooth' });
    });
    document.addEventListener('click', function(event) {
      var button = event.target.closest('[data-recommend-product]');
      if (!button) return;
      event.preventDefault();
      event.stopPropagation();
      var productKey = button.dataset.recommendProduct;
      var productCard = Array.prototype.slice.call(document.querySelectorAll('.product-card')).find(function(card) {
        var addButton = card.querySelector('.btn-add-cart');
        return addButton && addButton.getAttribute('data-product') === productKey;
      });
      if (productCard) {
        closeCart();
        productCard.click();
      }
    });
    closeBtn.addEventListener('click', closeCart);
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        if (paymentMethodOverlay && paymentMethodOverlay.classList.contains('open')) { closePaymentMethodModal(); return; }
        closeCart();
        if (settingsOverlay) settingsOverlay.classList.remove('open');
        if (checkoutFlowOverlay && checkoutFlowOverlay.classList.contains('open')) { closeCheckoutFlow(true); return; }
        document.getElementById('yapeOverlay').classList.remove('open');
        unlockScroll();
      }
    });

    var checkoutForm = document.getElementById('checkoutForm');
    var checkoutMessage = document.getElementById('checkoutMessage');
    var secureCheckoutBtn = document.getElementById('secureCheckoutBtn');
    var floatingSettings = document.getElementById('floatingSettings');
    var settingsOverlay = document.getElementById('settingsOverlay');
    var settingsClose = document.getElementById('settingsClose');
    var checkoutFlowOverlay = document.getElementById('checkoutFlowOverlay');
    var checkoutFlowBackBtn = document.getElementById('checkoutFlowBackBtn');
    var checkoutPaymentInfo = document.getElementById('checkoutPaymentInfo');
    var checkoutFlowQr = document.getElementById('checkoutFlowQr');
    var checkoutFlowAmount = document.getElementById('checkoutFlowAmount');
    var transferAmount = document.getElementById('transferAmount');
    var transferReceiptFile = document.getElementById('transferReceiptFile');
    var transferReceiptName = document.getElementById('transferReceiptName');
    var paymentTabs = document.querySelectorAll('.payment-tab');
    var paymentPanels = document.querySelectorAll('[data-payment-panel]');
    var paymentMethodOverlay = document.getElementById('paymentMethodOverlay');
    var paymentMethodClose = document.getElementById('paymentMethodClose');
    var paymentMethodPanels = document.querySelectorAll('[data-payment-method-panel]');
    var paymentMethodOptions = document.querySelectorAll('[data-payment-modal]');
    var paymentMethodDropdowns = document.querySelectorAll('.payment-method-dropdown');
    var paymentMethodYapeQr = document.getElementById('paymentMethodYapeQr');
    var paymentMethodPagoefectivoQr = document.getElementById('paymentMethodPagoefectivoQr');
    var paymentMethodYapeAmount = document.getElementById('paymentMethodYapeAmount');
    var paymentMethodPagoefectivoAmount = document.getElementById('paymentMethodPagoefectivoAmount');
    var paymentMethodTransferAmount = document.getElementById('paymentMethodTransferAmount');
    var paymentMethodYapeConfirm = document.getElementById('paymentMethodYapeConfirm');
    var checkoutStages = document.querySelectorAll('[data-checkout-stage]');
    var checkoutSteps = document.querySelectorAll('[data-checkout-step]');
    var checkoutSavedEmail = document.getElementById('checkoutSavedEmail');
    var checkoutEmailEditor = document.getElementById('checkoutEmailEditor');
    var checkoutStageEmail = document.getElementById('checkoutStageEmail');
    var checkoutEditEmailBtn = document.getElementById('checkoutEditEmailBtn');
    var checkoutSaveEmailBtn = document.getElementById('checkoutSaveEmailBtn');
    var checkoutCartContinueBtn = document.getElementById('checkoutCartContinueBtn');
    var checkoutDeliveryBackBtn = document.getElementById('checkoutDeliveryBackBtn');
    var checkoutDeliveryContinueBtn = document.getElementById('checkoutDeliveryContinueBtn');
    var checkoutPaymentBackBtn = document.getElementById('checkoutPaymentBackBtn');
    var deliveryOptions = document.querySelectorAll('.delivery-option');
    var deliveryAddressOverlay = document.getElementById('deliveryAddressOverlay');
    var deliveryAddressClose = document.getElementById('deliveryAddressClose');
    var deliveryAddressCancel = document.getElementById('deliveryAddressCancel');
    var deliveryAddressSave = document.getElementById('deliveryAddressSave');
    var deliveryAddressInput = document.getElementById('deliveryAddress');
    var activeOrder = null;
    var STORAGE_ORDERS = 'imfundo_orders';
    var STORAGE_CHECKOUT = 'imfundo_checkout';
    var activeCheckoutPayment = 'yape';
    var activeCheckoutStage = 'cart';
    var selectedDelivery = '';
    var pendingDeliveryOption = null;

    function getSavedCheckoutData() {
      try { return JSON.parse(localStorage.getItem(STORAGE_CHECKOUT) || '{}'); }
      catch(e) { return {}; }
    }

    function setCheckoutStage(stage) {
      activeCheckoutStage = stage;
      checkoutStages.forEach(function(panel) {
        panel.classList.toggle('active', panel.getAttribute('data-checkout-stage') === stage);
      });
      var order = ['cart', 'delivery', 'payment'];
      var stageIndex = order.indexOf(stage);
      checkoutSteps.forEach(function(step) {
        var stepIndex = order.indexOf(step.getAttribute('data-checkout-step'));
        step.classList.toggle('active', stepIndex === stageIndex);
        step.classList.toggle('done', stepIndex < stageIndex);
      });
      if (checkoutFlowBackBtn) {
        checkoutFlowBackBtn.textContent = stage === 'cart' ? '← Volver al carrito' : '← Volver';
      }
      if (stage === 'cart') refreshCheckoutEmail();
      if (stage === 'payment') { renderPaymentModal(); setCheckoutPayment('yape'); }
    }

    function openPaymentMethodModal(method) {
      paymentMethodPanels.forEach(function(panel) {
        panel.classList.toggle('active', panel.getAttribute('data-payment-method-panel') === method);
      });
      if (paymentMethodOverlay) paymentMethodOverlay.classList.add('open');
    }

    function closePaymentMethodModal() {
      if (paymentMethodOverlay) paymentMethodOverlay.classList.remove('open');
    }

    function refreshCheckoutEmail() {
      var customer = getSavedCheckoutData();
      var email = customer.email || '';
      if (checkoutSavedEmail) checkoutSavedEmail.textContent = email || 'Correo no registrado';
      if (checkoutStageEmail) checkoutStageEmail.value = email;
    }

    function saveStageEmail() {
      var email = checkoutStageEmail ? checkoutStageEmail.value.trim() : '';
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (checkoutStageEmail) checkoutStageEmail.focus();
        return false;
      }
      var customer = getSavedCheckoutData();
      customer.email = email;
      try { localStorage.setItem(STORAGE_CHECKOUT, JSON.stringify(customer)); } catch(e) {}
      var formEmail = document.getElementById('checkoutEmail');
      if (formEmail) formEmail.value = email;
      refreshCheckoutEmail();
      if (checkoutEmailEditor) checkoutEmailEditor.classList.remove('open');
      return true;
    }

    function selectDeliveryOption(option) {
      selectedDelivery = option ? (option.getAttribute('data-delivery') || '') : '';
      deliveryOptions.forEach(function(item) { item.classList.toggle('selected', item === option); });
      if (checkoutDeliveryContinueBtn) checkoutDeliveryContinueBtn.disabled = !selectedDelivery;
    }

    function openDeliveryAddressModal(option) {
      pendingDeliveryOption = option;
      var customer = getSavedCheckoutData();
      if (deliveryAddressInput) deliveryAddressInput.value = customer.address || '';
      if (deliveryAddressOverlay) deliveryAddressOverlay.classList.add('open');
      if (deliveryAddressInput) deliveryAddressInput.focus();
    }

    function closeDeliveryAddressModal() {
      if (deliveryAddressOverlay) deliveryAddressOverlay.classList.remove('open');
      pendingDeliveryOption = null;
    }

    function saveDeliveryAddress() {
      var address = deliveryAddressInput ? deliveryAddressInput.value.trim() : '';
      var customer = getSavedCheckoutData();
      customer.address = address;
      try { localStorage.setItem(STORAGE_CHECKOUT, JSON.stringify(customer)); } catch(e) {}
      var checkoutAddress = document.getElementById('checkoutAddress');
      if (checkoutAddress) checkoutAddress.value = address;
      selectDeliveryOption(pendingDeliveryOption);
      closeDeliveryAddressModal();
    }

    function openSettings() {
      if (!settingsOverlay) return;
      settingsOverlay.classList.add('open');
      document.body.classList.add('settings-open');
      document.documentElement.classList.add('settings-open');
    }

    function closeSettings() {
      if (!settingsOverlay) return;
      settingsOverlay.classList.remove('open');
      document.body.classList.remove('settings-open');
      document.documentElement.classList.remove('settings-open');
      _settingsFromCart = false;
    }

    if (floatingSettings) floatingSettings.addEventListener('click', openSettings);
    if (settingsClose) settingsClose.addEventListener('click', closeSettings);
    paymentTabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        setCheckoutPayment(tab.getAttribute('data-payment'));
      });
    });
    paymentMethodOptions.forEach(function(option) {
      option.addEventListener('click', function() { openPaymentMethodModal(option.getAttribute('data-payment-modal')); });
    });
    paymentMethodDropdowns.forEach(function(dropdown) {
      dropdown.addEventListener('toggle', function() {
        if (!dropdown.open) return;
        paymentMethodDropdowns.forEach(function(other) {
          if (other !== dropdown) other.open = false;
        });
      });
    });
    if (paymentMethodClose) paymentMethodClose.addEventListener('click', closePaymentMethodModal);
    if (paymentMethodOverlay) paymentMethodOverlay.addEventListener('click', function(event) {
      if (event.target === paymentMethodOverlay) closePaymentMethodModal();
    });
    if (paymentMethodYapeConfirm) paymentMethodYapeConfirm.addEventListener('click', function() {
      closePaymentMethodModal();
      openYapeCheckout();
    });
    if (checkoutEditEmailBtn) checkoutEditEmailBtn.addEventListener('click', function() {
      if (checkoutEmailEditor) checkoutEmailEditor.classList.add('open');
      if (checkoutStageEmail) checkoutStageEmail.focus();
    });
    if (checkoutSaveEmailBtn) checkoutSaveEmailBtn.addEventListener('click', saveStageEmail);
    if (checkoutCartContinueBtn) checkoutCartContinueBtn.addEventListener('click', function() {
      var customer = getSavedCheckoutData();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(customer.email || '')) {
        if (checkoutEmailEditor) checkoutEmailEditor.classList.add('open');
        if (checkoutStageEmail) checkoutStageEmail.focus();
        return;
      }
      setCheckoutStage('delivery');
    });
    deliveryOptions.forEach(function(option) {
      option.addEventListener('click', function() {
        openDeliveryAddressModal(option);
      });
    });
    if (deliveryAddressClose) deliveryAddressClose.addEventListener('click', closeDeliveryAddressModal);
    if (deliveryAddressCancel) deliveryAddressCancel.addEventListener('click', closeDeliveryAddressModal);
    if (deliveryAddressSave) deliveryAddressSave.addEventListener('click', saveDeliveryAddress);
    if (deliveryAddressOverlay) deliveryAddressOverlay.addEventListener('click', function(event) {
      if (event.target === deliveryAddressOverlay) closeDeliveryAddressModal();
    });
    if (checkoutDeliveryBackBtn) checkoutDeliveryBackBtn.addEventListener('click', function() { setCheckoutStage('cart'); });
    if (checkoutDeliveryContinueBtn) checkoutDeliveryContinueBtn.addEventListener('click', function() {
      if (selectedDelivery) setCheckoutStage('payment');
    });
    if (checkoutPaymentBackBtn) checkoutPaymentBackBtn.addEventListener('click', function() { setCheckoutStage('delivery'); });
    if (transferReceiptFile && transferReceiptName) {
      transferReceiptFile.addEventListener('change', function() {
        transferReceiptName.textContent = transferReceiptFile.files && transferReceiptFile.files[0]
          ? transferReceiptFile.files[0].name
          : 'Ningun archivo seleccionado';
      });
    }

    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function getCheckoutField(id) {
      var el = document.getElementById(id);
      return el ? el.value.trim() : '';
    }

    function getCustomerFields() {
      return {
        name: getCheckoutField('checkoutName'),
        phone: getCheckoutField('checkoutPhone').replace(/\s+/g, ''),
        email: getCheckoutField('checkoutEmail'),
        address: getCheckoutField('checkoutAddress')
      };
    }

    function validateCustomerFields() {
      var customer = getCustomerFields();
      if (customer.name.length < 3) return { ok: false, message: 'Ingresa el nombre completo del cliente.' };
      if (!/^9\d{8}$/.test(customer.phone)) return { ok: false, message: 'El telefono debe tener 9 digitos y empezar con 9.' };
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(customer.email)) return { ok: false, message: 'Ingresa un correo valido.' };
      return { ok: true, customer: customer };
    }

    var _settingsFromCart = false;

    function saveCheckoutFields() {
      var valid = validateCustomerFields();
      if (!valid.ok) {
        setCheckoutMessage('error', valid.message);
        return false;
      }

      try { localStorage.setItem(STORAGE_CHECKOUT, JSON.stringify(valid.customer)); } catch(e) {}
      var fromCart = _settingsFromCart;
      _settingsFromCart = false;
      if (fromCart) {
        setCheckoutMessage('success', 'Datos guardados. Volviendo al carrito...');
        setTimeout(function() {
          closeSettings();
          openMainCart();
        }, 600);
      } else {
        setCheckoutMessage('success', 'Datos guardados correctamente.');
        setTimeout(function() { setCheckoutMessage('', ''); }, 1800);
      }
      return true;
    }

    function loadCheckoutFields() {
      try {
        var data = JSON.parse(localStorage.getItem(STORAGE_CHECKOUT) || '{}');
        var map = { checkoutName: 'name', checkoutPhone: 'phone', checkoutEmail: 'email', checkoutAddress: 'address' };
        Object.keys(map).forEach(function(id) {
          var el = document.getElementById(id);
          if (el && data[map[id]]) el.value = data[map[id]];
        });
      } catch(e) {}
    }

    loadCheckoutFields();

    function getTotals() {
      var subtotal = calcSubtotal();
      var shipping = subtotal > 0 ? 9.90 : 0;
      var tax = subtotal * 0.10;
      return {
        subtotal: subtotal,
        shipping: shipping,
        tax: tax,
        total: subtotal + shipping + tax
      };
    }

    function setCheckoutMessage(type, text) {
      if (!checkoutMessage) return;
      checkoutMessage.className = 'checkout-message';
      if (type) checkoutMessage.classList.add(type === 'error' ? 'is-error' : 'is-success');
      checkoutMessage.textContent = text || '';
    }

    function validateCheckout(forceMethod) {
      var valid = validateCustomerFields();

      if (!cartItems.length) return { ok: false, message: 'Agrega al menos un producto al carrito.' };
      if (!valid.ok) return valid;

      return {
        ok: true,
        customer: valid.customer,
        method: 'yape'
      };
    }

    function renderCheckoutFlow(valid) {
      var customer = valid.customer;
      var totals = getTotals();

      if (checkoutFlowCustomer) {
        checkoutFlowCustomer.innerHTML =
          '<div class="checkout-detail"><span>Nombre</span><strong>' + escapeHtml(customer.name || 'Pendiente') + '</strong></div>' +
          '<div class="checkout-detail"><span>Telefono</span><strong>' + escapeHtml(customer.phone || 'Pendiente') + '</strong></div>' +
          '<div class="checkout-detail"><span>Correo</span><strong>' + escapeHtml(customer.email || 'Pendiente') + '</strong></div>' +
          '<div class="checkout-detail"><span>Direccion</span><strong>' + escapeHtml(customer.address || 'Pendiente') + '</strong></div>';
      }

      if (checkoutFlowItems) {
        checkoutFlowItems.innerHTML = cartItems.map(function(item) {
          var price = item.price !== null ? 'S/ ' + (item.price * item.qty).toFixed(2) : 'S/ --';
          return '<div class="checkout-flow-item">' +
            '<div>' +
              '<div class="checkout-flow-item-name">' + escapeHtml(item.name) + '</div>' +
              '<div class="checkout-flow-item-meta">' + escapeHtml(item.category) + ' · ' + escapeHtml(item.origin) + ' · Cantidad ' + item.qty + '</div>' +
            '</div>' +
            '<div class="checkout-flow-item-price">' + price + '</div>' +
          '</div>';
        }).join('');
      }

      if (checkoutFlowSummary) {
        checkoutFlowSummary.innerHTML = summaryRowsHtml(totals);
      }
    }

    function closeCheckoutFlow(backToCart) {
      if (!checkoutFlowOverlay) return;
      checkoutFlowOverlay.classList.remove('open');
      checkoutFlowOverlay.style.display = '';
      document.body.classList.remove('checkout-open');
      document.documentElement.classList.remove('checkout-open');
      unlockScroll();
      if (backToCart) openMainCart();
    }

    function renderPaymentModal() {
      var totals = getTotals();
      var qrData = 'IMFUNDO KAHLE | Pago Yape | S/ ' + totals.total.toFixed(2);
      if (checkoutFlowAmount) checkoutFlowAmount.textContent = 'S/ ' + totals.total.toFixed(2);
      if (transferAmount) transferAmount.textContent = 'S/ ' + totals.total.toFixed(2);
      if (checkoutFlowQr) {
        checkoutFlowQr.src = 'https://api.qrserver.com/v1/create-qr-code/?size=240x240&color=6B2699&bgcolor=FFFFFF&qzone=2&data=' + encodeURIComponent(qrData);
      }
      if (paymentMethodYapeQr) paymentMethodYapeQr.src = 'https://api.qrserver.com/v1/create-qr-code/?size=240x240&color=6B2699&bgcolor=FFFFFF&qzone=2&data=' + encodeURIComponent(qrData);
      if (paymentMethodPagoefectivoQr) paymentMethodPagoefectivoQr.src = 'https://api.qrserver.com/v1/create-qr-code/?size=240x240&color=222222&bgcolor=FFFFFF&qzone=2&data=' + encodeURIComponent('IMFUNDO KAHLE | PagoEfectivo | S/ ' + totals.total.toFixed(2));
      if (paymentMethodYapeAmount) paymentMethodYapeAmount.textContent = 'S/ ' + totals.total.toFixed(2);
      if (paymentMethodPagoefectivoAmount) paymentMethodPagoefectivoAmount.textContent = 'S/ ' + totals.total.toFixed(2);
      if (paymentMethodTransferAmount) paymentMethodTransferAmount.textContent = 'S/ ' + totals.total.toFixed(2);
    }

    function isUserConfigured() {
      try {
        var data = JSON.parse(localStorage.getItem(STORAGE_CHECKOUT) || '{}');
        return !!(data.name && data.phone && data.email && data.address);
      } catch(e) { return false; }
    }

    function openCheckoutFlow() {
      if (!cartItems.length) {
        setCheckoutMessage('error', 'Agrega al menos un producto al carrito.');
        return;
      }

      if (!isUserConfigured()) {
        closeCart();
        setCheckoutMessage('error', 'Completa tus datos de entrega antes de continuar con el pago.');
        _settingsFromCart = true;
        openSettings();
        return;
      }

      selectedDelivery = '';
      deliveryOptions.forEach(function(option) { option.classList.remove('selected'); });
      if (checkoutDeliveryContinueBtn) checkoutDeliveryContinueBtn.disabled = true;
      setCheckoutStage('cart');
      if (checkoutFlowOverlay) {
        closeCart();
        checkoutFlowOverlay.classList.add('open');
        document.body.classList.add('checkout-open');
        document.documentElement.classList.add('checkout-open');
        document.body.classList.remove('detail-open');
        document.documentElement.classList.remove('detail-open');
        lockScroll();
        trapFocus(checkoutFlowOverlay);
      }
    }

    if (checkoutFlowBackBtn) checkoutFlowBackBtn.addEventListener('click', function() {
      if (activeCheckoutStage === 'payment') setCheckoutStage('delivery');
      else if (activeCheckoutStage === 'delivery') setCheckoutStage('cart');
      else closeCheckoutFlow(true);
    });
    if (checkoutFlowOverlay) checkoutFlowOverlay.addEventListener('click', function(e) {
      if (e.target === checkoutFlowOverlay) closeCheckoutFlow(true);
    });
    function loadOrders() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_ORDERS) || '[]');
      } catch(e) {
        return [];
      }
    }

    function saveOrders(orders) {
      try { localStorage.setItem(STORAGE_ORDERS, JSON.stringify(orders)); } catch(e) {}
    }

    function createOrder(method, status) {
      var valid = validateCheckout(true);
      if (!valid.ok) {
        setCheckoutMessage('error', valid.message);
        openSettings();
        return null;
      }

      var totals = getTotals();
      var id = 'PED-' + new Date().getFullYear() + '-' + String(Date.now()).slice(-6);
      var order = {
        id: id,
        createdAt: new Date().toISOString(),
        status: status,
        method: method || valid.method,
        customer: valid.customer,
        items: cartItems.map(function(item) {
          return {
            name: item.name,
            category: item.category,
            origin: item.origin,
            price: item.price,
            qty: item.qty
          };
        }),
        totals: totals
      };

      var orders = loadOrders();
      orders.push(order);
      saveOrders(orders);
      activeOrder = order;
      return order;
    }

    function updateOrderStatus(orderId, status) {
      var orders = loadOrders();
      orders = orders.map(function(order) {
        if (order.id === orderId) {
          order.status = status;
          order.updatedAt = new Date().toISOString();
        }
        return order;
      });
      saveOrders(orders);
    }

    function createOrderWithAPI(method) {
      return new Promise(function(resolve, reject) {
        var valid = validateCustomerFields();
        if (!valid.ok) {
          setCheckoutMessage('error', valid.message);
          openSettings();
          reject(new Error(valid.message));
          return;
        }
        if (!cartItems.length) {
          reject(new Error('El carrito está vacío.'));
          return;
        }

        var apiItems = cartItems.map(function(item) {
          var p = _productMap && _productMap[item.name];
          return { code: p ? p.code : item.name, quantity: item.qty };
        });

        var totals = getTotals();

        fetch(API_BASE + '/api/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            customer: valid.customer,
            items: apiItems,
            paymentMethod: method,
            shippingCents: Math.round(totals.shipping * 100)
          })
        })
        .then(function(res) {
          return res.json().then(function(data) { return { ok: res.ok, data: data }; });
        })
        .then(function(result) {
          if (!result.ok) throw new Error(result.data.error || 'Error al crear la orden.');
          var apiOrder = result.data.order;
          activeOrder = {
            id: apiOrder.order_code,
            createdAt: apiOrder.created_at,
            status: apiOrder.payment_status,
            method: method,
            customer: valid.customer,
            totals: getTotals()
          };
          var localOrders = loadOrders();
          localOrders.push(activeOrder);
          saveOrders(localOrders);
          resolve(activeOrder);
        })
        .catch(function(err) {
          console.warn('[API] Orden local como fallback:', err.message);
          var order = createOrder(method, 'pending_payment');
          if (order) resolve(order);
          else reject(new Error('No se pudo crear la orden.'));
        });
      });
    }

    function updateYapeModal(order) {
      var qr = document.querySelector('.yape-qr-img');
      var orderId = document.getElementById('yapeOrderId');
      var amount = document.getElementById('yapeOrderAmount');
      var total = order.totals.total.toFixed(2);
      var data = 'IMFUNDO KAHLE | ' + order.id + ' | S/ ' + total;

      if (qr) {
        qr.src = 'https://api.qrserver.com/v1/create-qr-code/?size=220x220&color=6B2699&bgcolor=FFFFFF&qzone=2&data=' + encodeURIComponent(data);
      }
      if (orderId) orderId.textContent = order.id;
      if (amount) amount.textContent = 'Total: S/ ' + total;
    }

    function openYapeCheckout() {
      return createOrderWithAPI('yape').then(function(order) {
        closeCheckoutFlow();
        updateYapeModal(order);
        setCheckoutMessage('success', 'Orden ' + order.id + ' creada. Escanea el QR para pagar con Yape.');
        document.getElementById('yapeOverlay').classList.add('open');
        lockScroll();
      }).catch(function() {
        setCheckoutMessage('error', 'Verifica tus datos en Configuración antes de pagar.');
      });
    }

    function handleSecureCheckout() {
      openCheckoutFlow();
    }

    if (checkoutForm) checkoutForm.addEventListener('submit', function(e) {
      e.preventDefault();
      saveCheckoutFields();
    });
    if (secureCheckoutBtn) secureCheckoutBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      handleSecureCheckout();
    });

    // Pago con tarjeta: simulacion local para la demostracion.
    var cardDemoConfirmBtn = document.getElementById('cardDemoConfirmBtn');
    var cardDemoResult = document.getElementById('cardDemoResult');
    if (cardDemoConfirmBtn) {
      cardDemoConfirmBtn.addEventListener('click', function() {
        var order = createOrder('card', 'demo_approved');
        if (!order) return;

        cardDemoConfirmBtn.disabled = true;
        cardDemoConfirmBtn.textContent = 'Pago simulado aprobado';
        if (cardDemoResult) {
          cardDemoResult.textContent = 'Pago simulado aprobado. Pedido ' + order.id + ' creado correctamente. No se envio ni almaceno ningun dato de tarjeta.';
          cardDemoResult.classList.add('visible');
        }
      });
    }

    // ── Confirmar pedido con Yape ─────────────────────────────────
    var yapeConfirmBtn = document.getElementById('yapeConfirmBtn');
    if (yapeConfirmBtn) {
      yapeConfirmBtn.addEventListener('click', function() {
        yapeConfirmBtn.disabled = true;
        yapeConfirmBtn.textContent = 'Creando orden...';
        openYapeCheckout().finally(function() {
          yapeConfirmBtn.disabled = false;
          yapeConfirmBtn.textContent = 'Confirmar pedido con Yape';
        });
      });
    }

    // ── Enviar comprobante de transferencia ───────────────────────
    (function() {
      var confirmBtn = document.getElementById('transferConfirmBtn');
      var operationInput = document.getElementById('transferOperationNumber');
      var fileInput = document.getElementById('transferReceiptFile');
      var orderCodeEl = document.getElementById('transferOrderCode');

      if (!confirmBtn) return;

      function uploadReceipt(orderCode) {
        var operationNumber = operationInput ? operationInput.value.trim() : '';
        var file = fileInput && fileInput.files && fileInput.files[0];

        if (!operationNumber) {
          alert('Ingresa el número de operación bancaria.');
          return;
        }
        if (!file) {
          alert('Adjunta el comprobante de pago (imagen o PDF).');
          return;
        }

        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Enviando...';

        var formData = new FormData();
        formData.append('receipt', file);
        formData.append('operationNumber', operationNumber);

        fetch(API_BASE + '/api/orders/' + orderCode + '/receipt', {
          method: 'POST',
          body: formData
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.error) throw new Error(data.error);
          confirmBtn.textContent = '✓ Comprobante enviado';
          confirmBtn.style.background = '#16A34A';
          confirmBtn.style.color = '#fff';
        })
        .catch(function(err) {
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Enviar comprobante';
          alert('Error al enviar comprobante: ' + err.message);
        });
      }

      confirmBtn.addEventListener('click', function() {
        if (activeOrder) {
          uploadReceipt(activeOrder.id);
        } else {
          createOrderWithAPI('transfer').then(function(order) {
            if (orderCodeEl) orderCodeEl.textContent = order.id;
            uploadReceipt(order.id);
          }).catch(function() {
            setCheckoutMessage('error', 'Verifica tus datos en Configuración antes de enviar.');
          });
        }
      });
    })();

    window.imfundoOpenYapeCheckout = openYapeCheckout;
  })();

  // ── Yape Modal ────────────────────────────────────────────────
  (function() {
    var overlay  = document.getElementById('yapeOverlay');
    var closeBtn = document.getElementById('yapeClose');

    function closeYape() { overlay.classList.remove('open'); unlockScroll(); }

    if (closeBtn) closeBtn.addEventListener('click', closeYape);
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeYape();
    });
  })();
  </script>
