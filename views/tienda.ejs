  <script>
    // ── Conexión con la API ───────────────────────────────────────
    var API_BASE = 'http://localhost:3000';
    var _productMap = null; // { frontend_name: producto }

    function loadProducts() {
      return fetch(API_BASE + '/api/products')
        .then(function(res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function(data) {
          _productMap = {};
          (data.products || []).forEach(function(p) {
            _productMap[p.frontend_name] = p;
          });
        })
        .catch(function(err) {
          console.warn('[API] No disponible, usando datos del HTML como fallback:', err.message);
          _productMap = null;
        });
    }

    function apiPrice(frontendName, fallback) {
      if (_productMap && _productMap[frontendName]) {
        return parseFloat(_productMap[frontendName].price);
      }
      return fallback;
    }

    function apiOrigin(frontendName, fallback) {
      if (_productMap && _productMap[frontendName]) {
        return (_productMap[frontendName].origin || fallback).toUpperCase();
      }
      return fallback;
    }

    function apiStock(frontendName) {
      if (_productMap && _productMap[frontendName]) {
        return _productMap[frontendName].stock > 0;
      }
      return true; // fallback: asumir en stock
    }

    // Actualiza precios y stock de las tarjetas estáticas del HTML
    function syncStaticCardPrices() {
      if (!_productMap) return;
      document.querySelectorAll('#productGrid .product-card').forEach(function(card) {
        var nameEl = card.querySelector('.product-name');
        if (!nameEl) return;
        var name = nameEl.textContent.trim();
        var p = _productMap[name];
        if (!p) return;

        // Precio actual
        var priceStrong = card.querySelector('.product-price strong');
        if (priceStrong) priceStrong.textContent = parseFloat(p.price).toFixed(0);

        // Precio anterior (tachado)
        var oldPriceEl = card.querySelector('.old-price');
        if (oldPriceEl && p.old_price) {
          oldPriceEl.textContent = 'S/ ' + parseFloat(p.old_price).toFixed(0);
        }

        // Stock
        var stockBadge = card.querySelector('.stock-badge');
        if (stockBadge) {
          if (p.stock === 0) {
            stockBadge.innerHTML = '<span class="stock-dot" style="background:#9CA3AF"></span> Sin stock';
            stockBadge.style.color = '#9CA3AF';
            var addBtn = card.querySelector('.btn-add-cart');
            if (addBtn) { addBtn.disabled = true; addBtn.style.opacity = '0.45'; }
            var wrap = card.querySelector('.product-image-wrap');
            if (wrap && !wrap.querySelector('.sin-stock-ribbon')) {
              var ribbon = document.createElement('div');
              ribbon.className = 'sin-stock-ribbon';
              ribbon.textContent = 'Sin stock';
              wrap.appendChild(ribbon);
            }
          }
        }

        // Origen
        var originEl = card.querySelector('.product-origin');
        if (originEl && p.origin) originEl.textContent = p.origin.toUpperCase();
      });
    }

