        btn.innerHTML = open
          ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Cerrar filtros'
          : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg> Filtros';
      });
    })();

    // ── Price range slider ────────────────────────────────────────
    (function() {
      var track    = document.querySelector('.price-track');
      var fill     = document.querySelector('.price-fill');
      var thumbMin = document.querySelector('.price-thumb-min');
      var thumbMax = document.querySelector('.price-thumb-max');
      var label    = document.querySelector('.price-range-label');
      if (!track) return;

      // Rango dinámico basado en precios reales
      var prices = [];
      document.querySelectorAll('.product-price strong').forEach(function(el) {
        var v = parseFloat(el.textContent);
        if (!isNaN(v)) prices.push(v);
      });
      var MIN = prices.length ? Math.floor(Math.min.apply(null, prices)) : 0;
      var MAX = prices.length ? Math.ceil(Math.max.apply(null, prices))  : 100;
      if (MIN === MAX) { MIN = 0; MAX = MAX + 10; }

      var curMin = MIN, curMax = MAX;

      function valToPct(v) { return (v - MIN) / (MAX - MIN); }
      function pctToVal(p) { return MIN + (MAX - MIN) * p; }

      function updateUI() {
        var lo = valToPct(curMin) * 100;
        var hi = valToPct(curMax) * 100;
        fill.style.left  = lo + '%';
        fill.style.right = (100 - hi) + '%';
        thumbMin.style.left = 'calc(' + lo + '% - 8px)';
        thumbMax.style.left = 'calc(' + hi + '% - 8px)';
        label.textContent = 'S/ ' + curMin.toFixed(2) + ' – S/ ' + curMax.toFixed(2);
      }

      function filterByPrice() {
        window.productPriceFilter = { min: curMin, max: curMax };
        if (typeof window.applyProductFilters === 'function') {
          window.applyProductFilters();
        }
      }

      function makeDraggable(thumb, isMin) {
        function move(clientX) {
          var rect = track.getBoundingClientRect();
          var pct  = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
          var val  = pctToVal(pct);
          if (isMin) {
            curMin = Math.max(MIN, Math.min(val, curMax - 1));
          } else {
            curMax = Math.min(MAX, Math.max(val, curMin + 1));
          }
          updateUI();
          filterByPrice();
        }

        thumb.addEventListener('mousedown', function(e) {
          e.preventDefault();
          function onMove(e) { move(e.clientX); }
          function onUp()    { document.removeEventListener('mousemove', onMove); document.removeEventListener('mouseup', onUp); }
          document.addEventListener('mousemove', onMove);
          document.addEventListener('mouseup', onUp);
        });

        thumb.addEventListener('touchstart', function() {
          function onMove(e) { move(e.touches[0].clientX); }
          function onEnd()   { document.removeEventListener('touchmove', onMove); document.removeEventListener('touchend', onEnd); }
          document.addEventListener('touchmove', onMove, { passive: true });
          document.addEventListener('touchend', onEnd);
        }, { passive: true });
      }

      makeDraggable(thumbMin, true);
      makeDraggable(thumbMax, false);
      updateUI();
    })();

    // ── Filtros por checkboxes ────────────────────────────────────
    (function() {
      function applyCheckboxFilters() {
        if (typeof window.applyProductFilters === 'function') {
          window.applyProductFilters();
          return;
        }
        var activeDepartamentos = [];
        var activeCategorias = [];

        document.querySelectorAll('.filter-group').forEach(function(group) {
          var summary = group.querySelector('summary');
          if (!summary) return;
          var label = summary.childNodes[0].textContent.trim().toLowerCase();
          group.querySelectorAll('input[type="checkbox"]:checked').forEach(function(cb) {
            var val = cb.parentElement.textContent.trim();
            if (label === 'departamento' || label === 'departamento ') {
              activeDepartamentos.push(val.toUpperCase());
            } else if (label === 'categoría' || label === 'categoría ') {
              activeCategorias.push(val);
            }
          });
        });

        document.querySelectorAll('#productGrid .product-card').forEach(function(card) {
          var origin = (card.querySelector('.product-origin') || {}).textContent || '';
          var category = (card.querySelector('.product-category') || {}).textContent || '';
          var show = true;

          if (activeDepartamentos.length > 0 && activeDepartamentos.indexOf(origin) === -1) {
            show = false;
          }
          if (activeCategorias.length > 0 && activeCategorias.indexOf(category) === -1) {
            show = false;
          }

          var searchQuery = (document.getElementById('productSearch').value || '').trim().toLowerCase();
          if (show && searchQuery) {
            var text = (origin + ' ' + category + ' ' + (card.querySelector('.product-name') || {}).textContent).toLowerCase();
            if (text.indexOf(searchQuery) === -1) show = false;
          }

          card.style.display = show ? '' : 'none';
        });
      }

      document.querySelectorAll('.filter-sidebar input[type="checkbox"]').forEach(function(cb) {
        cb.addEventListener('change', applyCheckboxFilters);
      });
    })();
  </script>

