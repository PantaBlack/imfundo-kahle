          <div class="product-meta">
            <span class="product-origin">AREQUIPA</span>
            <svg class="info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          </div>
          <h3 class="product-name">Taza artesanal</h3>
          <span class="product-category">Cerámica</span>
          <div class="price-row">
