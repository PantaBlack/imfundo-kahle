    <main class="apadrina-page">
        <!-- 1. Hero Split Card -->
        <section class="apadrina-hero-section">
            <div class="apadrina-hero-wrap">
                <div class="apadrina-split-card">
                    <div class="apadrina-split-copy">
                        <h1 class="apadrina-split-title">Apadrina un niño</h1>
                        <h2 class="apadrina-split-subtitle">Acompaña su camino educativo.</h2>
                        <p class="apadrina-split-desc">Todos los niños tienen sueños y capacidades por descubrir, pero las dificultades económicas pueden limitar sus oportunidades. En Imfundo Kahle trabajamos para brindarles espacios donde puedan aprender, desarrollar sus habilidades y fortalecer su confianza. A través del apadrinamiento, puedes ayudarnos a hacerlo posible.</p>
                    </div>
                    <div class="apadrina-split-visual">
                        <img src="/img/apadrina%20papa%20noel.png" alt="Papá Noel junto a una niña de Imfundo Kahle recibiendo su regalo de Navidad" fetchpriority="high">
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. Sección "¿Por qué es importante?" -->
        <section class="apadrina-why-section">
            <div class="apadrina-why-wrap">
                <h2 class="why-heading"><span class="coral">¿Por qué</span> es importante?</h2>

                <div class="why-grid">
                    <!-- 1. Brinda a continuidad a su educación -->
                    <div class="why-item">
                        <div class="why-circle" aria-hidden="true">
                            <svg viewBox="0 0 64 64" fill="none" stroke="#ffffff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M32 16L10 27l22 11 22-11L32 16z" fill="rgba(255,255,255,0.2)" />
                                <path d="M18 31v14c0 6 6 11 14 11s14-5 14-11V31" />
                                <path d="M48 29v18c0 1.5-1 2-2 2s-2-.5-2-2V29" />
                            </svg>
                        </div>
                        <h3 class="why-label">Brinda a continuidad<br>a su educación</h3>
                    </div>

                    <!-- 2. Fortalece sus capacidades -->
                    <div class="why-item">
                        <div class="why-circle" aria-hidden="true">
                            <svg viewBox="0 0 64 64" fill="none" stroke="#ffffff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="14" y="38" width="6" height="14" rx="1" fill="rgba(255,255,255,0.25)" />
                                <rect x="23" y="32" width="6" height="20" rx="1" fill="rgba(255,255,255,0.25)" />
                                <rect x="32" y="26" width="6" height="26" rx="1" fill="rgba(255,255,255,0.25)" />
                                <rect x="41" y="20" width="6" height="32" rx="1" fill="rgba(255,255,255,0.25)" />
                                <path d="M12 40L24 28l9 8 18-18" stroke-width="3" />
                                <path d="M42 18h9v9" stroke-width="3" />
                            </svg>
                        </div>
                        <h3 class="why-label">Fortalece<br>sus capacidades</h3>
                    </div>

                    <!-- 3. Aumenta su confianza y autoestima -->
                    <div class="why-item">
                        <div class="why-circle" aria-hidden="true">
                            <svg viewBox="0 0 64 64" fill="#ffffff" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M32 50s-16-10-20-20c-3-8 3-16 11-16 5 0 9 4 9 7 0-3 4-7 9-7 8 0 14 8 11 16-4 10-20 20-20 20z" />
                            </svg>
                        </div>
                        <h3 class="why-label">Aumenta su<br>confianza y autoestima</h3>
                    </div>

                    <!-- 4. Contribuye a un mejor futuro -->
                    <div class="why-item">
                        <div class="why-circle" aria-hidden="true">
                            <svg viewBox="0 0 64 64" fill="#ffffff" stroke="none">
                                <circle cx="32" cy="22" r="6" />
                                <path d="M22 44c0-5.5 4.5-10 10-10s10 4.5 10 10v2H22v-2z" />
                                <circle cx="18" cy="26" r="4.5" />
                                <path d="M11 44c0-4 3.2-7.5 7.5-7.5 1.5 0 2.9.4 4 1.2-.5 1.8-.5 3.8-.5 6.3H11z" />
                                <circle cx="46" cy="26" r="4.5" />
                                <path d="M42 44c0-2.5 0-4.5-.5-6.3 1.1-.8 2.5-1.2 4-1.2 4.3 0 7.5 3.5 7.5 7.5H42z" />
                            </svg>
                        </div>
                        <h3 class="why-label">Contribuye a un<br>mejor futuro</h3>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. Sección "Ayúdanos a crear más oportunidades" -->
        <section class="apadrina-foot-section">
            <div class="apadrina-foot-wrap">
                <div class="apadrina-bottom-grid">
                    <div class="apadrina-bottom-visual">
                        <img src="/img/apadrina%20foot.png" alt="Niños y voluntarias compartiendo actividades de aprendizaje" loading="lazy">
                    </div>
                    <div class="apadrina-bottom-card">
                        <h2 class="bottom-card-title">Ayúdanos a crear más oportunidades</h2>
                        <p class="bottom-card-desc">Juntos podemos brindar a más niños las herramientas y experiencias que necesitan para desarrollar sus capacidades y construir un futuro con mayores posibilidades.</p>

                        <h3 class="bottom-card-subtitle">¿Cómo puedes apadrinar?</h3>
                        <p class="bottom-card-contact">Contáctanos: Escríbenos por WhatsApp al +51 954 920 068 para conocer cómo funciona nuestro programa de apadrinamiento.</p>

                        <div class="bottom-card-btn-wrap">
                            <a class="apadrinar-btn" href="https://wa.me/51954920068?text=Hola,%20deseo%20conocer%20m%C3%A1s%20sobre%20el%20programa%20de%20apadrinamiento" target="_blank" rel="noopener noreferrer">Quiero apadrinar</a>
                        </div>
                    </div>
                </div>

                <div class="apadrina-actions">
                    <a class="button button-outline" href="/se-un-voluntario">← Volver a opciones de participación</a>
                </div>
            </div>
        </section>
