        <section class="impact" aria-label="Nuestro impacto">
            <div class="impact-grid section-wrap">
                <article class="impact-item"><span class="impact-icon" aria-hidden="true">✳</span><strong>500+</strong><p>Niños y mujeres<br>beneficiados</p></article>
                <article class="impact-item"><span class="impact-icon" aria-hidden="true">♥</span><strong>100+</strong><p>Voluntarios nacionales<br>e internacionales</p></article>
                <article class="impact-item"><span class="impact-icon" aria-hidden="true">⌂</span><strong>2</strong><p>Sedes: una en Lima<br>y otra en Iquitos</p></article>
                <article class="impact-item"><span class="impact-icon" aria-hidden="true">✓</span><strong>20+</strong><p>Años transformando<br>vidas</p></article>
            </div>
        </section>

        <section class="news section-wrap" id="noticias">
            <div class="section-heading news-heading"><div><p class="eyebrow">Historias de nuestra comunidad</p><h2>Noticias</h2></div><div class="news-controls" aria-label="Navegar noticias"><button class="news-control" type="button" data-news-step="-1" aria-label="Noticia anterior">←</button><button class="news-control" type="button" data-news-step="1" aria-label="Siguiente noticia">→</button></div></div>
            <div class="news-grid" role="region" aria-label="Carrusel de noticias" tabindex="0">
                <article class="news-card"><button class="news-card-button" type="button" data-news-date="29 septiembre 2026 · Iquitos, Perú" data-news-title="Aprender también es explorar: nuestra visita a CREA" data-news-image="/img/Confraternizacion.jpeg" data-news-alt="Niños y voluntarios visitando CREA en Iquitos" data-news-summary="Una jornada para conocer y cuidar la fauna amazónica junto a nuestros niños, profesores y voluntarios." data-news-detail="Nuestros niños visitaron CREA, un centro de protección de animales amazónicos, acompañados por profesores y voluntarios." data-news-extra="Durante el paseo conocieron datos interesantes sobre los animales de la Amazonía y compartieron una jornada de aprendizaje y confraternización."><span class="news-card-image-frame"><img src="/img/Confraternizacion.jpeg" alt="Niños y voluntarios visitando CREA en Iquitos" loading="lazy"></span><span class="news-copy"><span class="news-date">29 septiembre 2026 · Iquitos</span><span class="news-title">Aprender también es explorar: nuestra visita a CREA</span><span class="news-summary">Una jornada para conocer y cuidar la fauna amazónica junto a nuestros niños, profesores y voluntarios.</span><span class="news-read-more">Leer historia <span aria-hidden="true">↗</span></span></span></button></article>
                <article class="news-card"><button class="news-card-button" type="button" data-news-date="29 septiembre 2026 · Solidaridad" data-news-title="Una rifa solidaria que nació al ritmo de BTS" data-news-image="/img/rifa.jpg" data-news-alt="Voluntaria de Imfundo Kahle junto al logo de la organización" data-news-summary="Cada número vendido nos acercó un poco más a la construcción de nuestra escuela en Iquitos." data-news-detail="Cada número vendido representó un aporte para seguir avanzando con la construcción de nuestra escuela en Iquitos." data-news-extra="Gracias a todas las personas que participaron, compartieron la iniciativa y ayudaron a difundirla, logramos recaudar alrededor de S/ 600 en muy poco tiempo."><span class="news-card-image-frame"><img src="/img/rifa.jpg" alt="Voluntaria de Imfundo Kahle junto al logo de la organización" loading="lazy"></span><span class="news-copy"><span class="news-date">29 septiembre 2026 · Solidaridad</span><span class="news-title">Una rifa solidaria que nació al ritmo de BTS</span><span class="news-summary">Cada número vendido nos acercó un poco más a la construcción de nuestra escuela en Iquitos.</span><span class="news-read-more">Leer historia <span aria-hidden="true">↗</span></span></span></button></article>
                <article class="news-card"><button class="news-card-button" type="button" data-news-date="Septiembre 2026 · Comunidad" data-news-title="Más personas se suman a nuestra escuelita" data-news-image="/img/chino.jpeg" data-news-alt="Se-I Kang junto a un artista durante un concierto" data-news-summary="Se-I Kang se unió a nuestra campaña con un aporte para seguir creando oportunidades de aprendizaje." data-news-detail="Se-I Kang, intérprete de conciertos asiáticos en nuestro país y traductora en los tres conciertos de BTS en Perú, se sumó a nuestra campaña." data-news-extra="Su donación apoya la construcción de nuestra escuela en Iquitos y crea nuevas oportunidades de aprendizaje para la comunidad."><span class="news-card-image-frame"><img class="news-card-chino-image" src="/img/chino.jpeg" alt="Se-I Kang junto a un artista durante un concierto" loading="lazy"></span><span class="news-copy"><span class="news-date">Septiembre 2026 · Comunidad</span><span class="news-title">Más personas se suman a nuestra escuelita</span><span class="news-summary">Se-I Kang se unió a nuestra campaña con un aporte para seguir creando oportunidades de aprendizaje.</span><span class="news-read-more">Leer historia <span aria-hidden="true">↗</span></span></span></button></article>
                <article class="news-card"><button class="news-card-button" type="button" data-news-date="9 octubre 2026 · AWLC" data-news-title="Guardianes del Itaya: un proyecto que educa para proteger" data-news-image="/img/FOTO EVENTO.png" data-news-alt="Niños y voluntarios comparten una actividad en comunidad" data-news-summary="El proyecto Guardianes del Itaya, reconocido por la AWLC, promueve la educación ambiental y el compromiso de los niños de Belén, Iquitos, con la protección de su río y su bosque." data-news-detail="Nuestro proyecto Guardianes del Itaya recibió un reconocimiento de la AWLC (Club Literario de Mujeres Americanas) por su compromiso con la educación ambiental en Belén, Iquitos." data-news-extra="A través de este proyecto, sembramos conciencia, despertamos la creatividad y enseñamos a los niños a proteger el río Itaya y su bosque, formando nuevas generaciones comprometidas con el cuidado de su entorno."><span class="news-card-image-frame"><img src="/img/FOTO EVENTO.png" alt="Niños y voluntarios comparten una actividad en comunidad" loading="lazy"></span><span class="news-copy"><span class="news-date">9 octubre · Comunidad</span><span class="news-title">Guardianes del Itaya: un proyecto que educa para proteger</span><span class="news-summary">El proyecto Guardianes del Itaya, reconocido por la AWLC, promueve la educación ambiental y el compromiso de los niños de Belén, Iquitos, con la protección de su río y su bosque.</span><span class="news-read-more">Leer historia <span aria-hidden="true">↗</span></span></span></button></article>
                <article class="news-card"><button class="news-card-button" type="button" data-news-date="16 octubre 2026 · Iquitos" data-news-title="La escuela de Iquitos sigue tomando forma" data-news-image="/img/COLEGIO.JPEG" data-news-alt="La escuela de Iquitos sigue tomando forma" data-news-summary="Nuestra escuela en Iquitos sigue tomando forma gracias al apoyo de quienes nos ayudan a construir un espacio seguro, lleno de aprendizaje, esperanza y nuevas oportunidades para nuestros niños." data-news-detail="La construcción de nuestra escuela en Iquitos llegó a su quinta semana y, poco a poco, los espacios donde nuestros niños aprenderán y crecerán empiezan a tomar forma." data-news-extra="Gracias al apoyo de quienes creen en este sueño, seguimos avanzando hacia nuestra meta: brindar a los niños un espacio seguro, lleno de aprendizaje, esperanza y nuevas oportunidades. ¡Cada aporte nos acerca un poco más!"><span class="news-card-image-frame"><img src="/img/COLEGIO.JPEG" alt="Colegio" loading="lazy"></span><span class="news-copy"><span class="news-date">16 octubre 2026 · Iquitos</span><span class="news-title">La escuela de Iquitos sigue tomando forma</span><span class="news-summary">Nuestra escuela en Iquitos sigue tomando forma gracias al apoyo de quienes nos ayudan a construir un espacio seguro, lleno de aprendizaje, esperanza y nuevas oportunidades para nuestros niños.</span><span class="news-read-more">Leer historia <span aria-hidden="true">↗</span></span></span></button></article>
            </div>
        </section>

