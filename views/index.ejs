        <section class="newsletter" id="boletines">
            <div class="newsletter-inner section-wrap">
                <div class="newsletter-title"><p class="eyebrow eyebrow-light">Ideas, noticias e impacto</p><h2>Boletines</h2><h3>Conoce nuestros<br>últimos boletines</h3>
                    <div class="bulletin-cards">
                        <article class="bulletin-card"><img src="/img/Septiembre.png" alt="Boletín de septiembre de 2026 de Imfundo Kahle" loading="lazy"><div class="language-links"><a href="https://drive.google.com/file/d/1v_S7zdTWpJhJhhD8f8vObSvKAGvi2Y1t/view?usp=sharing" target="_blank" rel="noopener noreferrer">Español</a><a href="https://drive.google.com/file/d/1vUH2gQ6YkM-TieeX4vZEW8PbKeDKCv6n/view?usp=sharing" target="_blank" rel="noopener noreferrer">Inglés</a></div></article>
                        <article class="bulletin-card"><img src="/img/Agosto.png" alt="Boletín de agosto de 2026 de Imfundo Kahle" loading="lazy"><div class="language-links"><a href="https://drive.google.com/file/d/1Zij1lnIYxWheB5D85h-NXu4wKxoM8NMc/view?usp=share_link" target="_blank" rel="noopener noreferrer">Español</a><a href="https://drive.google.com/file/d/1QHRQj9eLY3_-hg4BceNpghl-MZm7hP68/view?usp=share_link" target="_blank" rel="noopener noreferrer">Inglés</a></div></article>
                    </div>
                </div>
                <div class="newsletter-side"><div class="year-links" aria-label="Boletines por año"><a href="#boletines">2026</a><a href="#boletines">2025</a><a href="#boletines">2024</a></div><form class="subscribe-form"><label for="email">Déjanos tu correo para recibirlos cada mes</label><div class="email-field"><input id="email" name="email" type="email" placeholder="tucorreo@ejemplo.com" required><button type="submit" aria-label="Suscribirme">→</button></div><p class="form-feedback" aria-live="polite"></p></form></div>
            </div>
